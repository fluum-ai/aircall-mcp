# Create credentials in Aircall Dashboard → Integrations → API keys.
# Never commit real values.
AIRCALL_API_ID=
AIRCALL_API_TOKEN=

# Optional request timeout in milliseconds (default: 30000).
AIRCALL_TIMEOUT_MS=30000

# HTTP mode (Docker / Coolify). Local MCP clients can keep using stdio.
# MCP_TRANSPORT=http
# HOST=0.0.0.0
# PORT=8000
# MCP_PATH=/mcp
# Recommended when the server is reachable over the network.
# MCP_AUTH_TOKEN=
